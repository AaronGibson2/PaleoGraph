{
  "version": 8,
  "name": "PaleoGraph / Limestone atlas v1",
  "metadata": {
    "paleograph:version": "1",
    "paleograph:description": "Project-owned editorial style; present-day geography, not paleogeography."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "atlas": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> &middot; <a href=\"https://www.openmaptiles.org/\">&copy; OpenMapTiles</a> &middot; <a href=\"https://www.openstreetmap.org/copyright\">&copy; OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {
      "id": "atlas-paper",
      "type": "background",
      "paint": {
        "background-color": "#ede5d2"
      }
    },
    {
      "id": "woodland",
      "type": "fill",
      "source": "atlas",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#b5bca2",
        "fill-opacity": 0.35
      },
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "wood"
      ]
    },
    {
      "id": "water",
      "type": "fill",
      "source": "atlas",
      "source-layer": "water",
      "paint": {
        "fill-color": "#86aaa1",
        "fill-antialias": true
      },
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ]
    },
    {
      "id": "shoreline",
      "type": "line",
      "source": "atlas",
      "source-layer": "water",
      "paint": {
        "line-color": "#658b81",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.4,
          10,
          1.2
        ],
        "line-opacity": 0.6
      }
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "atlas",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#7fa49b",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.3,
          12,
          1.4
        ]
      },
      "minzoom": 6
    },
    {
      "id": "state-boundaries",
      "type": "line",
      "source": "atlas",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#8a7b62",
        "line-width": 0.8,
        "line-dasharray": [
          3,
          3
        ],
        "line-opacity": 0.6
      },
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "admin_level"
          ],
          4
        ],
        [
          "!=",
          [
            "get",
            "maritime"
          ],
          1
        ]
      ]
    },
    {
      "id": "country-boundaries",
      "type": "line",
      "source": "atlas",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#766954",
        "line-width": 1,
        "line-opacity": 0.6
      },
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "admin_level"
          ],
          2
        ],
        [
          "!=",
          [
            "get",
            "maritime"
          ],
          1
        ]
      ]
    },
    {
      "id": "quiet-roads",
      "type": "line",
      "source": "atlas",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#c2b698",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.4,
          14,
          1.5
        ],
        "line-opacity": 0.55
      },
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary"
        ],
        true,
        false
      ],
      "minzoom": 8
    },
    {
      "id": "labels-country",
      "type": "symbol",
      "source": "atlas",
      "source-layer": "place",
      "paint": {
        "text-color": "#535c4f",
        "text-halo-color": "#ede5d2",
        "text-halo-width": 1.3
      },
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "country"
      ],
      "minzoom": 1,
      "maxzoom": 6,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 13,
        "text-letter-spacing": 0.14,
        "text-transform": "uppercase",
        "text-padding": 12
      }
    },
    {
      "id": "labels-state",
      "type": "symbol",
      "source": "atlas",
      "source-layer": "place",
      "paint": {
        "text-color": "#535c4f",
        "text-halo-color": "#ede5d2",
        "text-halo-width": 1.3
      },
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "state"
      ],
      "minzoom": 5,
      "maxzoom": 9,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "text-letter-spacing": 0.14,
        "text-transform": "uppercase",
        "text-padding": 12
      }
    },
    {
      "id": "labels-city",
      "type": "symbol",
      "source": "atlas",
      "source-layer": "place",
      "paint": {
        "text-color": "#535c4f",
        "text-halo-color": "#ede5d2",
        "text-halo-width": 1.3
      },
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "city"
      ],
      "minzoom": 6,
      "maxzoom": 14,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-letter-spacing": 0.02,
        "text-transform": "none",
        "text-padding": 12
      }
    },
    {
      "id": "labels-town",
      "type": "symbol",
      "source": "atlas",
      "source-layer": "place",
      "paint": {
        "text-color": "#535c4f",
        "text-halo-color": "#ede5d2",
        "text-halo-width": 1.3
      },
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "town"
      ],
      "minzoom": 10,
      "maxzoom": 18,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-letter-spacing": 0.02,
        "text-transform": "none",
        "text-padding": 12
      }
    }
  ]
}
