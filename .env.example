# Local development only. Keep these credentials consistent with DATABASE_URL.
POSTGRES_DB=paleograph
POSTGRES_USER=paleograph
POSTGRES_PASSWORD=paleograph_local
POSTGRES_PORT=5432
# URL-encode special characters in the password when editing this URL.
DATABASE_URL=postgresql+psycopg://paleograph:paleograph_local@127.0.0.1:5432/paleograph
# JSON array of exact web origins; no wildcard.
CORS_ORIGINS=["http://localhost:3000"]

# Browser-visible configuration, read by Next.js from this root .env.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Owned editorial style; OpenFreeMap tiles/fonts, required OSM/OpenMapTiles attribution.
# May be replaced by another provider style URL. Blank disables basemap.
NEXT_PUBLIC_MAP_STYLE_URL=/styles/paleograph.json

# Optional developer bulk storage, independent of scientific identities.
# Default is this repository's data directory.
# PALEOGRAPH_DATA_ROOT=/absolute/path/to/PaleoGraphData
# UV_CACHE_DIR=/absolute/path/to/PaleoGraphData/cache/uv
# Actual operator-verified host Docker disk image or PostgreSQL data location.
# PALEOGRAPH_POSTGRES_STORAGE_PATH=/absolute/path/to/docker_data.vhdx
PALEOGRAPH_HEAVY_WORK_PAUSED=false
